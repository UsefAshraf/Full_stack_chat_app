# MongoDB connection string (local, Docker, or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/chatapp

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# Port the API / Socket.IO server listens on
PORT=3001

# URL of the React client (used for CORS)
CLIENT_URL=http://localhost:3000
